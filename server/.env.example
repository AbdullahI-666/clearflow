PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

DATABASE_URL=postgresql://postgres:password@localhost:5432/clearflow
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Official Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# 1. Create OAuth Client ID -> Web Application
# 2. Authorized JavaScript Origins: http://localhost:3000, http://localhost:5173
# 3. Authorized Redirect URIs: http://localhost:3000/auth/callback/google, http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Official Apple Sign-In Credentials (https://developer.apple.com/account/resources/identifiers/list/serviceId)
# 1. Register Services ID (e.g., com.clearflow.web)
# 2. Configure Return URLs: http://localhost:3000/auth/callback/apple, http://localhost:5173/auth/callback/apple
APPLE_CLIENT_ID=com.clearflow.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3000/auth/callback/apple
